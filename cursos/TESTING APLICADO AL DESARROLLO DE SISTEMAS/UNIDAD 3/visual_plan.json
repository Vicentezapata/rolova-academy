        "text",
        "diagram"
      ],
      "decoration_hints": [
        "W2"
      ],
      "speaker_notes": "No todo se automatiza. Pruebas de regresión sí, pruebas exploratorias no.",
      "html_content": "<div style=\"display:flex; flex-direction:column; justify-content:center; height:100%; gap:24px;\">\n  <h2 style=\"font-family:var(--display-font); font-size:48px; color:var(--text-primary); margin:0;\">¿Cuándo Automatizar?</h2>\n  <div style=\"background:var(--card-bg-from); border:1px solid var(--card-border); border-radius:var(--card-radius); padding:24px; display:flex; flex-direction:column; flex:1; justify-content:center;\">\n    <p style=\"color:var(--text-secondary); font-size:24px; line-height:1.6;\">No todo se automatiza. Pruebas de regresión sí, pruebas exploratorias no.</p>\n  </div>\n</div>"
