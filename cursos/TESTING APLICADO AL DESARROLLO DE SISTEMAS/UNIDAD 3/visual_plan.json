      "html_content": "<div style=\"display:grid; grid-template:repeat(2, 1fr) / repeat(3, 1fr); gap:20px; height:100%;\">\n  <div style=\"grid-column:1/3; background:var(--card-bg-from); border:1px solid var(--card-border); border-radius:var(--card-radius); padding:24px; display:flex; flex-direction:column;\"><h2 style=\"font-family:var(--display-font); color:var(--text-primary); font-size:32px;\">El Stack de Automatización</h2><p style=\"color:var(--text-secondary); font-size:18px;\">Ecosistema robusto de herramientas.</p></div>\n  <div style=\"background:var(--card-bg-from); border:1px solid var(--accent-1); border-radius:var(--card-radius); padding:24px; display:flex; flex-direction:column;\"><h3 style=\"color:var(--text-primary);\">Selenium</h3><p style=\"color:var(--text-secondary);\">Web automatization</p></div>\n  <div style=\"background:var(--card-bg-from); border:1px solid var(--accent-2); border-radius:var(--card-radius); padding:24px; display:flex; flex-direction:column;\"><h3 style=\"color:var(--text-primary);\">Appium</h3><p style=\"color:var(--text-secondary);\">Mobile testing</p></div>\n  <div style=\"background:var(--card-bg-from); border:1px solid var(--accent-3); border-radius:var(--card-radius); padding:24px; display:flex; flex-direction:column;\"><h3 style=\"color:var(--text-primary);\">Cucumber</h3><p style=\"color:var(--text-secondary);\">BDD Framework</p></div>\n  <div style=\"background:var(--card-bg-from); border:1px solid var(--accent-4); border-radius:var(--card-radius); padding:24px; display:flex; flex-direction:column;\"><h3 style=\"color:var(--text-primary);\">Robot FW</h3><p style=\"color:var(--text-secondary);\">Keyword-driven</p></div>\n</div>"
